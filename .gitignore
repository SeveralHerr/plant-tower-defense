# Godot 4+ specific ignores
.godot/
/android/

# Self-test harness scratch. The verify ledger is the one file worth keeping —
# it is the record of how often the harness was load-bearing, and it only has
# value by being long.
.gates/*


# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# /verify scratch runner logs
lint.log
tests.log

# Agent git worktrees live inside the repo; never commit them as a nested repo.
.claude/worktrees/

# Python bytecode from the tools/ scripts.
__pycache__/
*.pyc

# Export output; CI rebuilds it on every deploy (see .github/workflows/deploy-to-itchio.yml)
bin/
