# Godot 4+ specific ignores
.godot/
/android/

# Self-test harness scratch. The verify ledger is the one file worth keeping —
# it is the record of how often the harness was load-bearing, and it only has
# value by being long.
.devtools/*
!.devtools/verify-runs.jsonl

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# /verify scratch runner logs
lint.log
tests.log
