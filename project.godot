; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="plant-tower-defense"
run/main_scene="uid://ce2dtga2f08e"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

; Web off Godot's Sample playback and back onto the engine mixer. The full argument,
; the measured WebAudio graph and the numbers are in game/sfx.gd beside `ensure_bus`;
; the short version is that runtime-created buses mirror into the browser's audio graph
; as a unity-gain feedback loop, and the shipped build clipped harder every second it ran.
; Comments here do not survive an editor settings save -- the test does. See
; test_web_playback_type_is_stream in test/unit/test_selftest.gd.
general/default_playback_type.web=0

[autoload]

DevTools="*res://addons/godot_selftest/dev_tools.gd"
RunConfig="*res://game/run_config.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
