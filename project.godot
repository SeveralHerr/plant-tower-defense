; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="plant-tower-defense"
run/main_scene="uid://ce2dtga2f08e"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

; Web off Godot's Sample playback and back onto the engine mixer. The full argument,
; the measured WebAudio graph and the numbers are in game/sfx.gd beside `ensure_bus`;
; the short version is that runtime-created buses mirror into the browser's audio graph
; as a unity-gain feedback loop, and the shipped build clipped harder every second it ran.
; Comments here do not survive an editor settings save -- the test does. See
; test_web_playback_type_is_stream in test/unit/test_selftest.gd.
general/default_playback_type.web=0

; Mobile is a phone running the Web build, and the line above is why it needed this one.
; Stream playback means the ENGINE mixes, in WASM; `variant/thread_support=false` in
; export_presets.cfg means that mixer's ring buffer is refilled from the main loop, once
; per rendered frame. Desktop at 60fps refills Godot's 50ms web default every 16.7ms and
; never notices. A phone at 25-30fps refills every 33-40ms, and one hitch -- a wave
; spawning, a volley landing, ambience plus a music bed plus eight Sfx voices in the same
; frame -- puts a refill past the buffer's own length. An underrun is heard as crackle and
; as drift, which is what a mobile player reported: distorted and laggy. 140ms is four
; frames at the 30fps this project's harness already gates on -- long frames arrive in
; bursts, so the headroom has to cover a burst rather than one overrun. It is a real trade:
; a button now sounds up to 90ms later than it did, and it buys back sound that was
; arriving broken. The floor is DERIVED from `fps_min` by the test below, which is what
; caught an earlier 120 here as too small -- retune it there, not by eye.
; The move that costs no latency is `variant/thread_support=true`, which mixes off the main
; thread; it needs SharedArrayBuffer, so it needs COOP/COEP headers from the host, and a
; host that does not send them serves a game that will not boot. Deploy-coupled, so not here.
; Comments here do not survive an editor settings save -- the test does. See
; test_web_audio_output_latency_has_mobile_headroom in test/unit/test_selftest.gd.
driver/output_latency.web=140

[autoload]

RunConfig="*res://game/run_config.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
